# Runtime
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
TEL_API_PORT=4000
NEXT_PUBLIC_TEL_API_BASE_URL=http://localhost:4000/api/v1

# PostgreSQL is the first-stage source of truth and durable job store.
DATABASE_URL=postgresql://wolinkup:wolinkup@localhost:5432/wolinkup
PG_BOSS_SCHEMA=platform_jobs
WORKER_QUEUE_ENABLED=false

# Independent WoLinkup Payment Platform integration.
# TEL stores only platform references and normalized projections.
PAYMENT_PLATFORM_BASE_URL=http://localhost:4100
PAYMENT_PLATFORM_API_KEY_REF=secret://local/payment-platform/api-key
PAYMENT_PLATFORM_WEBHOOK_SECRET_REF=secret://local/payment-platform/webhook-secret

# Supplier adapters use secret references; never commit production credentials.
SUPPLIER_DEFAULT_BASE_URL=http://localhost:4200
SUPPLIER_DEFAULT_API_KEY_REF=secret://local/suppliers/default/api-key

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=wolinkup-tel
